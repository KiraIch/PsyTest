# =============================================================================
# PsyTest — .gitignore
# 用途：集中管理 Git 版本控制排除規則
# 維護方式：定期更新（建議每次新增依賴、工具、產出物時同步檢視）
# 最後更新：2026-10-16（v0.2.0：新增數據輸出與檢查點規則）
# 維護者：KiraIch
#
# 更新指引：
# 1. 新增規則時請在對應章節下加入，並附上一行註解說明原因。
# 2. 修改後請同步更新 HANDOVER.md 中的「環境與忽略規則」章節。
# 3. 若不確定是否該忽略，優先忽略本機產出物與機敏資訊。
# =============================================================================

# ---------------------------------------------------------------------------
# 1. 作業系統產出物
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# 2. 編輯器與 IDE 設定（保留共用範本，忽略個人設定）
# ---------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/launch.json.example
# JetBrains (IntelliJ / PyCharm / WebStorm)
.idea/
*.iml
*.iws
# Vim / Emacs / Sublime
*.swp
*.swo
*~
\#*\#
.\#*
.sublime-workspace
.sublime-project

# ---------------------------------------------------------------------------
# 3. Git 與版本控制相關
# ---------------------------------------------------------------------------
*.orig
*.rej
*.patch

# ---------------------------------------------------------------------------
# 4. 大型模型權重與二進位資產（不進 Git，請另行分發）
# 說明：models/ 內含 GGUF 權重檔（單檔 >100MB），超出 GitHub 限制。
# 取得方式請見 README.md「模型檔案」章節與 HANDOVER.md。
# ---------------------------------------------------------------------------
*.gguf
*.ggml
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
# 注意：使用 models/* 而非 models/，以允許下方 ! 例外規則生效。
models/*
!models/.gitkeep
!models/README.md

# ---------------------------------------------------------------------------
# 5. Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
env/
ENV/
.venv/
.python-version
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# ---------------------------------------------------------------------------
# 6. Node.js / 前端
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml
.next/
.nuxt/
dist/
build/
out/
.turbo/
.parcel-cache/
.vite/
*.local

# ---------------------------------------------------------------------------
# 7. 環境變數與機敏資訊（絕對不可提交）
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json
config/local*.json
config/secrets*.yaml

# ---------------------------------------------------------------------------
# 8. 日誌、暫存檔與本機資料庫
# ---------------------------------------------------------------------------
# 注意：使用 logs/* 而非 logs/，以允許下方 .gitkeep 例外生效。
logs/*
!logs/.gitkeep
*.log
*.tmp
*.temp
*.bak
*.swp
.cache/
tmp/
temp/
*.sqlite
*.sqlite3
*.db
*.db-journal

# ---------------------------------------------------------------------------
# 9. 測試、覆蓋率與效能分析產出物
# ---------------------------------------------------------------------------
test-results/
junit*.xml
benchmark-results/
*.prof
*.lprof

# ---------------------------------------------------------------------------
# 10. 文件建置產出物
# ---------------------------------------------------------------------------
docs/_build/
site/
.mkdocs_cache/

# ---------------------------------------------------------------------------
# 11. OpenCode / AI 工具本機狀態（opencode.json 僅供本機使用，不公開）
# ---------------------------------------------------------------------------
opencode.json
.opencode/
.opencode-cache/
*.opencode.log

# ---------------------------------------------------------------------------
# 12. 專案特定：PsyTest 執行期產出（依實作進展定期擴充）
# ---------------------------------------------------------------------------
# 測驗結果、使用者資料匯出（涉及隱私，禁止提交）
# 注意：使用 /* 而非 /，以允許 .gitkeep 例外生效，維持目錄結構。
data/raw/
data/processed/
data/exports/
data/output/sessions/*
!data/output/sessions/.gitkeep
data/output/audio/*
!data/output/audio/.gitkeep
data/output/annotations/*
!data/output/annotations/.gitkeep
*.wav
*.mp3
*.flac
results/
outputs/
uploads/

# 批量生成檢查點與暫存
.checkpoints/
*.checkpoint.json
checkpoints/

# 本機實驗與草稿
experiments/
scratch/
playground/

# ---------------------------------------------------------------------------
# 13. 保留佔位符（若目錄目前為空，請保留 .gitkeep 以維持結構）
# ---------------------------------------------------------------------------
!.gitkeep
