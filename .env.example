# PsyTest 環境變數模板
# 複製為 .env 後填寫（.env 已於 .gitignore 排除，禁止提交）。
# cp .env.example .env

# Ollama 設定
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# 輸出設定
PSYTEST_OUTPUT_DIR=data/output
PSYTEST_SAVE_AUDIO=true
PSYTEST_SAVE_EMBEDDINGS=true

# 效能設定
PSYTEST_MAX_MEMORY_GB=
PSYTEST_GPU_LAYERS=auto
PSYTEST_TEMPERATURE_LIMIT=85

# 日誌
PSYTEST_LOG_LEVEL=INFO
